{
  "name": "cc-fix",
  "version": "0.1.1",
  "description": "Claude Code 环境安全检测与修复 CLI 工具",
  "type": "module",
  "bin": {
    "cc-fix": "dist/index.js"
  },
  "scripts": {
    "prepare": "node scripts/prepare-hooks.mjs",
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "claude",
    "claude-code",
    "environment-checker",
    "risk-analysis",
    "anthropic",
    "cursor",
    "claude-desktop",
    "cli",
    "security"
  ],
  "license": "MIT",
  "author": "cc-fix contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyijie85/cc-fix.git"
  },
  "homepage": "https://github.com/gongyijie85/cc-fix#readme",
  "bugs": {
    "url": "https://github.com/gongyijie85/cc-fix/issues"
  },
  "files": [
    "dist",
    "scripts/prepare-hooks.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.17.0"
  }
}
