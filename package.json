{
  "name": "cc-fix",
  "version": "0.2.0-rc.1",
  "description": "Claude Code 环境安全检测与修复 CLI 工具",
  "type": "module",
  "bin": {
    "cc-fix": "dist/index.js"
  },
  "scripts": {
    "prepare": "node scripts/prepare-hooks.mjs",
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:integration": "node scripts/not-implemented-stage.mjs test:integration",
    "test:gui": "node scripts/not-implemented-stage.mjs test:gui",
    "test:watch": "vitest",
    "build:core": "tsup",
    "build:desktop": "cargo build --release --locked --manifest-path src-tauri/Cargo.toml",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "verify:payload": "node scripts/verify-windows-payload.mjs",
    "test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/Test-InstallerLifecycle.ps1",
    "release:bundle": "pnpm build:installer",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:toolchain": "node scripts/validate-toolchain-lock.mjs",
    "release:validate": "pnpm check:version && pnpm check:toolchain"
  },
  "keywords": [
    "claude",
    "claude-code",
    "environment-checker",
    "risk-analysis",
    "anthropic",
    "cursor",
    "claude-desktop",
    "cli",
    "security"
  ],
  "license": "MIT",
  "author": "cc-fix contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyijie85/cc-fix.git"
  },
  "homepage": "https://github.com/gongyijie85/cc-fix#readme",
  "bugs": {
    "url": "https://github.com/gongyijie85/cc-fix/issues"
  },
  "files": [
    "dist",
    "scripts/prepare-hooks.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^20.17.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
